#!/usr/bin/env expect -f
# register-sdf.exp - Automate SDF newuser registration
#
# Usage: ./probes/register-sdf.exp [outfile]
#
# Environment variables (all optional):
#   DEMO_USER    - Desired username (default: test-sdf-XXXX random)
#   DEMO_PASS    - Password (default: generated)
#   DEMO_EMAIL   - Email (default: none/blank)
#   BANNER_TIMEOUT - Seconds to wait per prompt (default: 15)
#
# Set DEMO_EMAIL=skip to leave email blank.
# Set DEMO_PASS=prompt to type it manually.
#
# WARNING: This creates a REAL account on SDF. Use responsibly.
# SDF limits: accounts inactive 90 days are auto-deleted.

set timeout 15
if { [info exists env(BANNER_TIMEOUT)] } { set timeout $env(BANNER_TIMEOUT) }

set outfile [lindex $argv 0]
set demo_host "sdf.org"
set demo_port 22

# Generate random username if not set
if { [info exists env(DEMO_USER)] } {
    set demo_user $env(DEMO_USER)
} else {
    set rand [expr {int(rand() * 90000) + 10000}]
    set demo_user "test-sdf-$rand"
}

if { [info exists env(DEMO_PASS)] } {
    set demo_pass $env(DEMO_PASS)
} else {
    set rand2 [expr {int(rand() * 900000000) + 100000000}]
    set demo_pass "demo$rand2"
}

if { [info exists env(DEMO_EMAIL)] } {
    set demo_email $env(DEMO_EMAIL)
} else {
    set demo_email ""
}

set timestamp [clock format [clock seconds] -format "%Y-%m-%d %H:%M:%S"]

proc emit {text} {
    global outfile
    puts -nonewline $text
    if { $outfile != "" } {
        if { [catch {set fh [open $outfile a]}] } { return }
        puts -nonewline $fh $text
        close $fh
    }
}

emit "========================================\n"
emit "SDF REGISTRATION DEMO\n"
emit "Timestamp: $timestamp\n"
emit "========================================\n"
emit "Username: $demo_user\n"
emit "Host:     $demo_host:$demo_port\n"
emit "========================================\n\n"

spawn -noecho ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=10 -l newuser $demo_host

expect {
    -re "(?i)username|login|name.*:" {
        emit "[SERVER] $expect_out(buffer)\n"
        sleep 0.5
        send "$demo_user\r"
    }
    -re "(?i)password:" {
        emit "[SERVER] $expect_out(buffer)\n"
        emit "[UNEXPECTED: Already at password prompt]\n"
    }
    timeout {
        emit "TIMEOUT: SDF not responding\n"
        exit 1
    }
    eof {
        emit "EOF: Connection closed by server\n"
        exit 1
    }
}

# Expect password prompt
expect {
    -re "(?i)password|passwd" {
        emit "[SERVER] $expect_out(buffer)\n"
        sleep 0.3
        send "$demo_pass\r"
    }
    timeout {
        emit "TIMEOUT: No password prompt\n"
        exit 1
    }
}

# Expect password confirmation
expect {
    -re "(?i)again|confirm|re-enter|verify" {
        emit "[SERVER] $expect_out(buffer)\n"
        sleep 0.3
        send "$demo_pass\r"
    }
    timeout {
        emit "TIMEOUT: No password confirmation prompt\n"
        exit 1
    }
}

# Expect email prompt (usually optional)
expect {
    -re "(?i)mail|email|contact" {
        emit "[SERVER] $expect_out(buffer)\n"
        sleep 0.3
        if { $demo_email == "skip" || $demo_email == "" } {
            send "\r"
        } else {
            send "$demo_email\r"
        }
    }
    timeout {
        emit "TIMEOUT or no email prompt (OK)\n"
    }
}

# Expect shell selection or further prompts
expect {
    -re "(?i)shell|choice|select|option|default|continue|yes/no" {
        emit "[SERVER] $expect_out(buffer)\n"
        sleep 0.3
        # Take defaults
        send "\r"
        exp_continue
    }
    -re "(?i)success|created|welcome|account|thank" {
        emit "[SERVER] $expect_out(buffer)\n"
        emit "\n[REGISTRATION SUCCESSFUL]\n"
    }
    -re "(?i)error|fail|invalid|taken|exist" {
        emit "[SERVER] $expect_out(buffer)\n"
        emit "\n[REGISTRATION FAILED]\n"
    }
    timeout {
        emit "TIMEOUT: Registration flow unfinished\n"
        # Capture what we got
        emit "[PARTIAL] $expect_out(buffer)\n"
    }
}

# Try to capture any final message
expect {
    -re ".+" {
        emit "[FINAL] $expect_out(buffer)\n"
    }
    timeout {}
}

emit "\n========================================\n"
emit "Registration attempted for: $demo_user\n"
emit "Save these credentials if you plan to log in.\n"
emit "========================================\n"
exit 0
